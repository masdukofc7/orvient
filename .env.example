# =============================================================================
# Orvient — local / demo
#   cp .env.example .env   (or: pnpm setup:env)
# Prod (shared VPS):  infra/.env.production.example → docs/VPS.md
# Prod (dedicated):   docker-compose.prod.yml
# =============================================================================

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory

# --- Redis -------------------------------------------------------------------
# Set REDIS_DISABLED=true if Redis is not running locally
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=true

# --- App / URLs (local split ports: web :3000 → api :4000) --------------------
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# API_PORT=4000
# API_HOST=0.0.0.0
# APP_URL=http://localhost:3000

# --- Auth --------------------------------------------------------------------
# Production: ≥32 chars, must NOT contain "change-me"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# --- Seed (defaults: admin@inventory.local / Admin123!) ----------------------
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# PLATFORM_ADMIN_EMAIL=

# --- Email (Resend; logs to console if unset) --------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="Orvient <noreply@yourdomain.com>"

# --- Billing (Dodo; checkout 503 if unset) -----------------------------------
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_TEST_PRODUCT_ID=

# --- Media (Cloudflare R2 — org logo upload) ---------------------------------
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

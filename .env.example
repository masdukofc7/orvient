# Database
DATABASE_URL=postgresql://inventory:inventory@localhost:5432/inventory?schema=public
POSTGRES_USER=inventory
POSTGRES_PASSWORD=inventory
POSTGRES_DB=inventory

# Redis (optional locally — set REDIS_DISABLED=true if Redis is not installed)
REDIS_URL=redis://localhost:6379
REDIS_DISABLED=true

# JWT (access tokens only — refresh tokens are opaque DB hashes, not JWTs)
# Production: must be ≥32 chars and must NOT contain "change-me"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# API
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# ENABLE_SWAGGER=true  # force Swagger when NODE_ENV=production

# Web — must be the URL browsers use to reach the API (set before web Docker build)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Public app origin for digital receipt QR / copy-link (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true behind HTTPS; required true when NODE_ENV=production
COOKIE_SECURE=false
# strict when web+API share one origin (Caddy); lax for split hosts (localhost:3000→:4000)
COOKIE_SAME_SITE=lax

# Prisma pool size (appended to DATABASE_URL if missing)
# PRISMA_CONNECTION_LIMIT=10

# Seed (local/demo only — never use these passwords in real production)
SEED_ADMIN_EMAIL=admin@inventory.local
SEED_ADMIN_PASSWORD=Admin123!

# Platform admin (defaults to SEED_ADMIN_EMAIL)
# PLATFORM_ADMIN_EMAIL=admin@inventory.local

# --- Production (docker-compose.prod.yml) ---
# DOMAIN=app.example.com
# CORS_ORIGIN=https://app.example.com
# NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
# NEXT_PUBLIC_APP_URL=https://app.example.com
# COOKIE_SECURE=true
# POSTGRES_PASSWORD=<strong-unique-password>
# JWT_ACCESS_SECRET=<openssl rand -base64 48>
# NODE_ENV=production

# Billing — Dodo Payments (optional locally; checkout returns 503 if unset)
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_ENVIRONMENT=test_mode
# DODO_TEST_PRODUCT_ID=
# APP_URL=http://localhost:3000

# Email — Resend (optional locally; emails log to API console if unset)
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=Orvient <noreply@yourdomain.com>
# APP_URL=http://localhost:3000

# Error tracking (optional)
# SENTRY_DSN=

# =============================================================================
# Orvient — production (shared VPS + Cloudflare Tunnel)
#   cp infra/.env.production.example .env.production
#   chmod 600 .env.production
# Deploy: ./scripts/deploy-vps.sh   Docs: docs/VPS.md
# =============================================================================

# --- Database ----------------------------------------------------------------
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=replace-with-strong-postgres-password
# DATABASE_URL is injected by Compose (do not set unless overriding)

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=replace-with-strong-redis-password
# REDIS_URL is injected by Compose

# --- App / URLs --------------------------------------------------------------
# PUBLIC_HOST = hostname only (no scheme). CNAME → <TUNNEL_ID>.cfargotunnel.com
PUBLIC_HOST=app.example.com
NODE_ENV=production
CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_URL=https://app.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://app.example.com
APP_URL=https://app.example.com
COOKIE_SECURE=true
# COOKIE_SAME_SITE=strict
# ENABLE_SWAGGER=false

# --- Auth --------------------------------------------------------------------
# ≥32 chars, must NOT contain "change-me"
JWT_ACCESS_SECRET=replace-with-openssl-rand-base64-48
# JWT_ACCESS_EXPIRES=15m
# JWT_REFRESH_EXPIRES=7d

# --- Cloudflare Tunnel -------------------------------------------------------
# From credentials.json TunnelID, or: cloudflared tunnel create orvient
CLOUDFLARE_TUNNEL_ID=

# --- Seed / platform (first boot only; then rotate password) -----------------
# PLATFORM_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=

# --- Email (Resend) ----------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM=Orvient <noreply@example.com>

# --- Billing (Dodo) ----------------------------------------------------------
# DODO_PAYMENTS_API_KEY=
# DODO_PAYMENTS_WEBHOOK_KEY=
# DODO_PAYMENTS_ENVIRONMENT=live_mode
# DODO_TEST_PRODUCT_ID=

# --- Observability -----------------------------------------------------------
# SENTRY_DSN=
